{
  "_file": "scenarios.json",
  "_purpose": "The rescue triage tree. A few honest questions lead from panic to the exact recipe.",
  "_author": "Amey Thakur",
  "_github": "https://github.com/Amey-Thakur",
  "_tech": "JSON, consumed by fix.js; leaves resolve to intents in intents.json",
  "_description": "Each node asks one question. Options lead to another node or to a leaf, which is the id of a full answer with danger levels and undo.",
  "_date": "2026-08-07",
  "updated": "2026-08-07",
  "start": "root",
  "nodes": {
    "root": {
      "q": "What went wrong?",
      "opts": [
        {
          "label": "A commit is wrong",
          "next": "committed"
        },
        {
          "label": "I lost work",
          "next": "lost"
        },
        {
          "label": "Push or pull fails",
          "next": "sync"
        },
        {
          "label": "A conflict is blocking me",
          "next": "conflict"
        },
        {
          "label": "My files are a mess",
          "next": "mess"
        },
        {
          "label": "Wrong branch",
          "next": "branch"
        },
        {
          "label": "Git is stuck mid-operation",
          "next": "stuck"
        },
        {
          "label": "Something on GitHub is wrong",
          "next": "gh"
        }
      ]
    },
    "committed": {
      "q": "Is the commit pushed?",
      "opts": [
        {
          "label": "Not pushed",
          "next": "committed-local"
        },
        {
          "label": "Pushed, only I use this branch",
          "next": "committed-own"
        },
        {
          "label": "Pushed, teammates have it",
          "next": "committed-shared"
        }
      ]
    },
    "committed-local": {
      "q": "What is wrong with it?",
      "opts": [
        {
          "label": "The message",
          "leaf": "edit-commit-message"
        },
        {
          "label": "A file is missing from it",
          "leaf": "add-to-last-commit"
        },
        {
          "label": "The whole commit",
          "leaf": "undo-last-commit"
        },
        {
          "label": "It contains a secret",
          "leaf": "remove-secret-from-history"
        },
        {
          "label": "It sits on the wrong branch",
          "leaf": "move-commits-to-branch"
        }
      ]
    },
    "committed-own": {
      "q": "What do you need? (Rewrites end with a force-with-lease push.)",
      "opts": [
        {
          "label": "Fix the message or content",
          "leaf": "edit-commit-message"
        },
        {
          "label": "Combine messy commits into one",
          "leaf": "squash-commits"
        },
        {
          "label": "Remove one commit entirely",
          "leaf": "delete-commit"
        },
        {
          "label": "It contains a secret",
          "leaf": "remove-secret-from-history"
        }
      ]
    },
    "committed-shared": {
      "q": "Shared history is never rewritten. These undo by moving forward.",
      "opts": [
        {
          "label": "Undo the last commit",
          "leaf": "undo-last-commit"
        },
        {
          "label": "Undo an older commit",
          "leaf": "delete-commit"
        },
        {
          "label": "Undo a merge",
          "leaf": "undo-merge"
        },
        {
          "label": "A secret leaked",
          "leaf": "remove-secret-from-history"
        }
      ]
    },
    "lost": {
      "q": "What is missing?",
      "opts": [
        {
          "label": "A commit or a whole branch",
          "leaf": "recover-lost-commit"
        },
        {
          "label": "Everything since a rebase",
          "leaf": "undo-rebase"
        },
        {
          "label": "A stash",
          "leaf": "recover-dropped-stash"
        },
        {
          "label": "A file deleted somewhere in history",
          "leaf": "restore-deleted-file"
        },
        {
          "label": "Edits I discarded before committing",
          "leaf": "discard-changes"
        }
      ]
    },
    "sync": {
      "q": "Where does it fail?",
      "opts": [
        {
          "label": "Push is rejected",
          "next": "sync-push"
        },
        {
          "label": "Pull complains",
          "next": "sync-pull"
        },
        {
          "label": "Authentication fails",
          "next": "sync-auth"
        }
      ]
    },
    "sync-push": {
      "q": "What does the rejection say?",
      "opts": [
        {
          "label": "non-fast-forward, or fetch first",
          "errleaf": "non-fast-forward-rejected"
        },
        {
          "label": "no upstream branch",
          "leaf": "push-new-branch"
        },
        {
          "label": "src refspec does not match any",
          "errleaf": "src-refspec"
        },
        {
          "label": "a file exceeds 100 MB",
          "errleaf": "file-size-limit-exact"
        },
        {
          "label": "Large files, and I want this to stop happening",
          "leaf": "git-lfs"
        }
      ]
    },
    "sync-pull": {
      "q": "What does pull say?",
      "opts": [
        {
          "label": "Branches have diverged",
          "errleaf": "diverged-msg"
        },
        {
          "label": "Local changes would be overwritten",
          "leaf": "stash"
        },
        {
          "label": "Cannot rebase, unstaged changes",
          "leaf": "autostash"
        },
        {
          "label": "Refusing to merge unrelated histories",
          "errleaf": "unrelated-histories"
        }
      ]
    },
    "sync-auth": {
      "q": "Which flavor?",
      "opts": [
        {
          "label": "Permission denied (publickey)",
          "errleaf": "publickey-denied"
        },
        {
          "label": "Authentication failed over HTTPS",
          "leaf": "stop-password-prompts"
        }
      ]
    },
    "mess": {
      "q": "What kind of mess?",
      "opts": [
        {
          "label": "Uncommitted edits I want gone",
          "leaf": "discard-changes"
        },
        {
          "label": "Untracked files everywhere",
          "leaf": "remove-untracked"
        },
        {
          "label": "Make my branch match the remote exactly",
          "leaf": "reset-to-remote"
        },
        {
          "label": "I need these edits later, just not now",
          "leaf": "stash"
        },
        {
          "label": "Conflict markers inside my files",
          "leaf": "merge-conflict"
        }
      ]
    },
    "branch": {
      "q": "What happened?",
      "opts": [
        {
          "label": "Committed on main instead of a feature branch",
          "leaf": "move-commits-to-branch"
        },
        {
          "label": "Uncommitted work, wrong branch",
          "leaf": "move-changes-to-branch"
        },
        {
          "label": "Detached HEAD",
          "leaf": "detached-head"
        },
        {
          "label": "The branch name is wrong",
          "leaf": "rename-branch"
        }
      ]
    },
    "stuck": {
      "q": "Stuck how?",
      "opts": [
        {
          "label": "A rebase, merge, or cherry-pick is in progress",
          "leaf": "abort-operation"
        },
        {
          "label": "index.lock: another process seems to be running",
          "errleaf": "index-lock-exists"
        },
        {
          "label": "An editor opened and trapped me",
          "leaf": "exit-vim"
        }
      ]
    },
    "conflict": {
      "q": "What does the conflict look like?",
      "opts": [
        {
          "label": "Conflict markers inside a file",
          "errleaf": "merge-conflict-marker"
        },
        {
          "label": "One side changed it, the other deleted it",
          "errleaf": "conflict-modify-delete"
        },
        {
          "label": "A binary file, which cannot be merged line by line",
          "leaf": "binary-conflict"
        },
        {
          "label": "I want one side to win, wholesale",
          "leaf": "merge-take-side"
        },
        {
          "label": "Which files are still conflicted?",
          "leaf": "list-conflicts"
        },
        {
          "label": "The same conflict keeps coming back",
          "leaf": "rerere"
        },
        {
          "label": "It is on a pull request, and I would rather use the browser",
          "leaf": "resolve-conflicts-online"
        },
        {
          "label": "I want out of this entirely",
          "leaf": "abort-operation"
        }
      ]
    },
    "gh": {
      "q": "Which part of GitHub?",
      "opts": [
        {
          "label": "A pull request will not merge",
          "next": "gh-pr"
        },
        {
          "label": "A workflow is failing",
          "next": "gh-actions"
        },
        {
          "label": "My Pages site is wrong",
          "next": "gh-pages"
        },
        {
          "label": "I am blocked from pushing",
          "next": "gh-access"
        },
        {
          "label": "My fork is out of date",
          "leaf": "sync-fork"
        }
      ]
    },
    "gh-pr": {
      "q": "What is holding it up?",
      "opts": [
        {
          "label": "It says the branch has conflicts",
          "errleaf": "pr-has-conflicts"
        },
        {
          "label": "A required check is expected but never ran",
          "errleaf": "required-check-expected"
        },
        {
          "label": "It needs an approving review",
          "errleaf": "approving-review-required"
        },
        {
          "label": "It was removed from the merge queue",
          "errleaf": "merge-queue-removed"
        },
        {
          "label": "I need to answer the review comments",
          "leaf": "handle-review-feedback"
        }
      ]
    },
    "gh-actions": {
      "q": "What does the run say?",
      "opts": [
        {
          "label": "Permission to the repository denied to github-actions",
          "errleaf": "gha-permission"
        },
        {
          "label": "The job never started, for billing reasons",
          "errleaf": "actions-billing-blocked"
        },
        {
          "label": "It needs a secret it cannot see",
          "leaf": "actions-secrets"
        },
        {
          "label": "Nothing obvious: I just want to run it again",
          "leaf": "rerun-checks"
        }
      ]
    },
    "gh-pages": {
      "q": "What is wrong with the site?",
      "opts": [
        {
          "label": "It is not showing my latest push",
          "leaf": "pages-not-updating"
        },
        {
          "label": "Files beginning with an underscore are missing",
          "leaf": "nojekyll"
        },
        {
          "label": "The deployment failed with a 404",
          "errleaf": "pages-deploy-404"
        },
        {
          "label": "I want it on my own domain",
          "leaf": "pages-custom-domain"
        }
      ]
    },
    "gh-access": {
      "q": "What does the refusal say?",
      "opts": [
        {
          "label": "Write access to repository not granted",
          "errleaf": "write-access-not-granted"
        },
        {
          "label": "GH006: protected branch update failed",
          "errleaf": "gh006-protected"
        },
        {
          "label": "GH013: repository rule violations",
          "errleaf": "repository-rule-violations"
        },
        {
          "label": "Push cannot contain secrets",
          "errleaf": "secret-scanning-push-blocked"
        },
        {
          "label": "My SSO session has expired",
          "errleaf": "sso-session-expired"
        }
      ]
    }
  }
}
